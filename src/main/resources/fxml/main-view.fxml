<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pksmatches.ui.MainController"
            styleClass="main-root">

    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="toolbar">
            <padding>
                <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
            </padding>
            <Label fx:id="userLabel" styleClass="user-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Обновить" onAction="#onRefreshClick" styleClass="secondary-button"/>
            <Button text="Экспорт CSV" onAction="#onExportClick" styleClass="secondary-button"/>
            <Button text="Выйти" onAction="#onLogoutClick" styleClass="danger-button"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <Tab text="Матчи">
                <BorderPane>
                    <top>
                        <VBox spacing="8.0" styleClass="filter-panel">
                            <padding>
                                <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
                            </padding>

                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <Label text="Поиск:"/>
                                <TextField fx:id="searchField"
                                           promptText="команда или турнир"
                                           onKeyReleased="#onSearchChanged"
                                           prefWidth="260.0"/>

                                <Label text="Статус:"/>
                                <ComboBox fx:id="statusFilter" promptText="Все" prefWidth="150.0"/>

                                <Label text="Турнир:"/>
                                <ComboBox fx:id="tournamentFilter" promptText="Все" prefWidth="200.0"/>

                                <Label text="С даты:"/>
                                <DatePicker fx:id="dateFromFilter" prefWidth="140.0"/>

                                <Label text="По дату:"/>
                                <DatePicker fx:id="dateToFilter" prefWidth="140.0"/>

                                <Button text="Сбросить" onAction="#onResetFiltersClick"
                                        styleClass="secondary-button"/>
                            </HBox>
                        </VBox>
                    </top>

                    <center>
                        <TableView fx:id="matchTable" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                                <TableColumn fx:id="colTournament" text="Турнир" prefWidth="180.0"/>
                                <TableColumn fx:id="colTeam1" text="Команда 1" prefWidth="140.0"/>
                                <TableColumn fx:id="colTeam2" text="Команда 2" prefWidth="140.0"/>
                                <TableColumn fx:id="colDate" text="Дата и время" prefWidth="150.0"/>
                                <TableColumn fx:id="colStage" text="Этап" prefWidth="130.0"/>
                                <TableColumn fx:id="colStatus" text="Статус" prefWidth="110.0"/>
                                <TableColumn fx:id="colScore" text="Счёт" prefWidth="80.0"/>
                            </columns>
                        </TableView>
                    </center>

                    <bottom>
                        <HBox spacing="8.0" styleClass="action-bar">
                            <padding>
                                <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
                            </padding>
                            <Button text="Добавить матч" onAction="#onAddMatchClick"
                                    styleClass="primary-button"/>
                            <Button text="Редактировать" onAction="#onEditMatchClick"
                                    styleClass="secondary-button"/>
                            <Button text="Удалить" onAction="#onDeleteMatchClick"
                                    styleClass="danger-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Начать (LIVE)" onAction="#onStartMatchClick"
                                    styleClass="secondary-button"/>
                            <Button text="Завершить" onAction="#onFinishMatchClick"
                                    styleClass="secondary-button"/>
                            <Button text="Отменить" onAction="#onCancelMatchClick"
                                    styleClass="secondary-button"/>
                            <Button text="Изменить счёт" onAction="#onUpdateScoreClick"
                                    styleClass="secondary-button"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </Tab>

            <Tab text="Турниры">
                <BorderPane>
                    <center>
                        <TableView fx:id="tournamentTable" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colTId" text="ID" prefWidth="60.0"/>
                                <TableColumn fx:id="colTName" text="Название" prefWidth="300.0"/>
                                <TableColumn fx:id="colTStart" text="Дата начала" prefWidth="150.0"/>
                                <TableColumn fx:id="colTEnd" text="Дата окончания" prefWidth="150.0"/>
                            </columns>
                        </TableView>
                    </center>
                    <bottom>
                        <HBox spacing="8.0" styleClass="action-bar">
                            <padding>
                                <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
                            </padding>
                            <Button text="Добавить турнир" onAction="#onAddTournamentClick"
                                    styleClass="primary-button"/>
                            <Button text="Редактировать" onAction="#onEditTournamentClick"
                                    styleClass="secondary-button"/>
                            <Button text="Удалить" onAction="#onDeleteTournamentClick"
                                    styleClass="danger-button"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </Tab>

            <Tab text="Статистика">
                <fx:include source="stats-view.fxml"/>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
