<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pksmatches.ui.LoginController"
      alignment="CENTER"
      spacing="12.0"
      styleClass="login-root">

    <padding>
        <Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/>
    </padding>

    <Label text="Агрегатор матчей" styleClass="login-title">
        <font>
            <Font size="22.0"/>
        </font>
    </Label>

    <Label text="Вход в систему" styleClass="login-subtitle"/>

    <TextField fx:id="usernameField"
               promptText="Логин"
               styleClass="login-input"/>

    <PasswordField fx:id="passwordField"
                   promptText="Пароль"
                   styleClass="login-input"/>

    <Label fx:id="errorLabel"
           styleClass="error-label"
           wrapText="true"
           visible="false"
           managed="false"/>

    <Button fx:id="loginButton"
            text="Войти"
            onAction="#onLoginClick"
            defaultButton="true"
            maxWidth="Infinity"
            styleClass="primary-button"/>

    <Label text="Тестовые учётки: admin / admin, user / user"
           styleClass="hint-label"/>
</VBox>
