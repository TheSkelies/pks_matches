<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pksmatches.ui.LoginController"
           styleClass="login-root">

    <VBox alignment="CENTER" spacing="14.0" styleClass="login-card"
          maxWidth="380.0" maxHeight="400.0">

        <Label text="⚽" styleClass="login-emoji"/>
        <Label text="Агрегатор матчей" styleClass="login-title"/>
        <Label text="Вход в систему" styleClass="login-subtitle"/>

        <TextField fx:id="usernameField"
                   promptText="Логин"
                   styleClass="login-input"/>

        <PasswordField fx:id="passwordField"
                       promptText="Пароль"
                       styleClass="login-input"/>

        <Label fx:id="errorLabel"
               styleClass="error-label"
               wrapText="true"
               maxWidth="300.0"
               visible="false"
               managed="false"/>

        <Button fx:id="loginButton"
                text="Войти"
                onAction="#onLoginClick"
                defaultButton="true"
                maxWidth="Infinity"
                styleClass="primary-button"/>

        <Label text="Тестовые учётки: admin / admin, user / user"
               styleClass="hint-label"/>

        <Label text="«Ankara Messi, Ankara Messi» 🐐"
               styleClass="hint-label"/>

        <padding>
            <Insets top="36.0" right="40.0" bottom="36.0" left="40.0"/>
        </padding>
    </VBox>
</StackPane>
