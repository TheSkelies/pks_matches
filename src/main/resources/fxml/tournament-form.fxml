<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pksmatches.ui.TournamentFormController"
      spacing="14.0"
      styleClass="form-root">

    <padding>
        <Insets top="18.0" right="24.0" bottom="18.0" left="24.0"/>
    </padding>

    <Label fx:id="titleLabel" text="Турнир" styleClass="form-title"/>

    <GridPane hgap="12.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="130.0" prefWidth="130.0"/>
            <ColumnConstraints minWidth="260.0" prefWidth="260.0"/>
        </columnConstraints>

        <Label text="Название:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="например, ЧМ по футболу 2024"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Дата начала:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="startDatePicker" maxWidth="Infinity"
                    GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Дата окончания:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="endDatePicker" maxWidth="Infinity"
                    GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="errorLabel"
           styleClass="error-label"
           wrapText="true"
           visible="false"
           managed="false"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Отмена" onAction="#onCancelClick" styleClass="secondary-button"/>
        <Button text="Сохранить" onAction="#onSaveClick" defaultButton="true"
                styleClass="primary-button"/>
    </HBox>
</VBox>
